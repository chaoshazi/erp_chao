# ---- 应用 ----
ERP_ENV=dev
ERP_LOG_LEVEL=INFO
ERP_TENANT_ID=default

# ---- 存储 ----
# sqlite = 本机零依赖（默认，适合开发与联调）；postgres = 生产
ERP_STORAGE=sqlite
ERP_SQLITE_PATH=data/erp.sqlite3
ERP_DATABASE_URL=postgresql+psycopg://erp:erp@localhost:5434/erp
# 启动时按元数据建表（CREATE TABLE IF NOT EXISTS，可重复执行）
ERP_AUTO_MIGRATE=true

# ---- 安全 ----
# 生产必须改：人工登录令牌与密码摘要都依赖它
ERP_SECRET_KEY=dev-only-change-me
ERP_TOKEN_TTL_HOURS=12
# AI 能力层（D:\codex）用的服务账号令牌，填到那边的 AICRM_ERP_API_TOKEN
ERP_SERVICE_TOKEN=dev-service-token
ERP_SERVICE_ACTOR_ID=ai-agent

# ---- 初始化数据 ----
# 写入与 D:\codex 的 fake 模式同 ID 的演示数据，便于两边结果对比
ERP_SEED_DEMO=true
# 首次启动创建管理员账号（仅当 users 表为空）
ERP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ERP_BOOTSTRAP_ADMIN_PASSWORD=admin12345
ERP_BOOTSTRAP_ADMIN_NAME=系统管理员

# ---- 前端 ----
# true 且 web/dist 存在时，由 FastAPI 托管前端构建产物
ERP_SERVE_WEB=true
ERP_WEB_DIST_DIR=web/dist
ERP_CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# ---- 分页与限制 ----
ERP_DEFAULT_PAGE_SIZE=50
ERP_MAX_PAGE_SIZE=200

# ---- 生产环境（ERP_ENV=prod / production / stage / staging）----
# 上面这些值是给本地开发用的。ERP_ENV 落到生产的这四个取值后，进程启动时会先校验
# 一遍，下面任何一项没做到就直接启动失败 —— 宁可起不来，也不要带着默认密钥对外服务。
# 校验实现在 app/core/config.py 的 Settings._guard_production，用例见
# tests/test_prod_guard.py。ERP_ENV 只认 dev / local / test / stage / staging /
# prod / production，写成 prd 之类的值会直接报错（否则生产保护会被静默关掉）。
#
#   ERP_SECRET_KEY                必填，至少 16 位随机串。这是人工登录令牌的
#                                 HMAC 密钥，泄露即可伪造任意用户身份
#   ERP_SERVICE_TOKEN             必填，至少 16 位随机串。必须与 D:\codex 的
#                                 AICRM_ERP_API_TOKEN 逐字一致，否则 AI 层同步失败
#   ERP_BOOTSTRAP_ADMIN_PASSWORD  必填，至少 12 位。users 表为空时拿它建管理员
#   ERP_SEED_DEMO                 必须 false，生产不写入演示数据
#   ERP_STORAGE                   建议 postgres；sqlite 是单文件存储
#   ERP_CORS_ORIGINS              不能出现 *，要逐个列出来源域名
#
# 只有存储这一项留了显式开关，其余项没有开关：
#   ERP_ALLOW_EPHEMERAL_STORAGE=true   确认要在生产跑 sqlite 单文件存储
#
# 生成随机串：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
